{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["systemd-resolved", "dns", "prometheus"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(systemd_resolved_exporter_up, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "systemd-resolved",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "systemd_resolved_exporter_up{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DNS transactions /s",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        { "expr": "rate(systemd_resolved_transactions_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}} total" },
        { "expr": "rate(systemd_resolved_transaction_timeouts_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}} timeouts" },
        { "expr": "rate(systemd_resolved_failed_responses_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}} failed" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(systemd_resolved_cache_hits_total{instance=~\"$instance\"}[5m]) / clamp_min(rate(systemd_resolved_cache_hits_total{instance=~\"$instance\"}[5m]) + rate(systemd_resolved_cache_misses_total{instance=~\"$instance\"}[5m]), 1)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache entries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "systemd_resolved_cache_entries{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DNSSEC verdicts /s",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (result) (rate(systemd_resolved_dnssec_verdicts_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
